{
  "info": {
    "name": "Marketplace E2E",
    "description": "E2E API test chạy vào backend thật (Postgres thật, Flyway thật). Các request chạy theo thứ tự và truyền id cho nhau qua collection variables. Chỉ cần sẵn một tài khoản ADMIN; customer, seller, category, sản phẩm và đơn vị vận chuyển đều được tạo mới ở mỗi lần chạy. Xem README.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Admin login",
      "item": [
        {
          "name": "Admin login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 and admin token', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const data = pm.response.json().data;",
                  "  pm.expect(data.user.role).to.eql('ADMIN');",
                  "  pm.collectionVariables.set('adminToken', data.accessToken);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{adminEmail}}\",\"password\":\"{{adminPassword}}\"}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        }
      ]
    },
    {
      "name": "1. Auth journey",
      "item": [
        {
          "name": "Register customer",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('customerEmail', 'e2e-customer-' + Date.now() + '@test.dev');",
                  "pm.collectionVariables.set('password', 'E2e@Pass123');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 and CUSTOMER role', () => {",
                  "  pm.response.to.have.status(201);",
                  "  const data = pm.response.json().data;",
                  "  pm.expect(data.user.role).to.eql('CUSTOMER');",
                  "  pm.collectionVariables.set('customerToken', data.accessToken);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{customerEmail}}\",\"password\":\"{{password}}\",\"name\":\"E2E Customer\"}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Login with a wrong password is 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{customerEmail}}\",\"password\":\"wrong-password\"}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Login customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 with a token pair', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const data = pm.response.json().data;",
                  "  pm.expect(data.accessToken).to.be.a('string');",
                  "  pm.collectionVariables.set('customerToken', data.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', data.refreshToken);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{customerEmail}}\",\"password\":\"{{password}}\"}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Get my profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 and my email', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().data.email).to.eql(pm.collectionVariables.get('customerEmail'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": "{{baseUrl}}/users/me"
          }
        },
        {
          "name": "Refresh rotates the token pair",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 with a new refresh token', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const data = pm.response.json().data;",
                  "  pm.expect(data.refreshToken).to.not.eql(pm.collectionVariables.get('refreshToken'));",
                  "  pm.collectionVariables.set('oldRefreshToken', pm.collectionVariables.get('refreshToken'));",
                  "  pm.collectionVariables.set('refreshToken', data.refreshToken);",
                  "  pm.collectionVariables.set('customerToken', data.accessToken);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"refreshToken\":\"{{refreshToken}}\"}"
            },
            "url": "{{baseUrl}}/auth/refresh"
          }
        },
        {
          "name": "Reusing the old refresh token is 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"refreshToken\":\"{{oldRefreshToken}}\"}"
            },
            "url": "{{baseUrl}}/auth/refresh"
          }
        },
        {
          "name": "Customer cannot call admin endpoints",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": "{{baseUrl}}/admin/carriers"
          }
        },
        {
          "name": "Orders without a token is 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/orders"
          }
        }
      ]
    },
    {
      "name": "2. Admin carriers",
      "item": [
        {
          "name": "Create an active carrier",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('carrierName', 'E2E Carrier ' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 and active', () => {",
                  "  pm.response.to.have.status(201);",
                  "  const data = pm.response.json().data;",
                  "  pm.expect(data.active).to.eql(true);",
                  "  pm.collectionVariables.set('carrierId', data.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"{{carrierName}}\"}"
            },
            "url": "{{baseUrl}}/admin/carriers"
          }
        },
        {
          "name": "Duplicate name ignoring case is 400",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('carrierNameUpper', pm.collectionVariables.get('carrierName').toUpperCase());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"{{carrierNameUpper}}\"}"
            },
            "url": "{{baseUrl}}/admin/carriers"
          }
        },
        {
          "name": "Create a second carrier",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201', () => {",
                  "  pm.response.to.have.status(201);",
                  "  pm.collectionVariables.set('inactiveCarrierId', pm.response.json().data.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"E2E Off {{$timestamp}}\"}"
            },
            "url": "{{baseUrl}}/admin/carriers"
          }
        },
        {
          "name": "Deactivate the second carrier",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 and inactive', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().data.active).to.eql(false);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"active\":false}"
            },
            "url": "{{baseUrl}}/admin/carriers/{{inactiveCarrierId}}"
          }
        }
      ]
    },
    {
      "name": "3. Seller onboarding",
      "item": [
        {
          "name": "Register seller (PENDING)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('sellerEmail', 'e2e-seller-' + Date.now() + '@test.dev');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 and SELLER role', () => {",
                  "  pm.response.to.have.status(201);",
                  "  const data = pm.response.json().data;",
                  "  pm.expect(data.user.role).to.eql('SELLER');",
                  "  pm.collectionVariables.set('sellerId', data.user.id);",
                  "  pm.collectionVariables.set('sellerToken', data.accessToken);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{sellerEmail}}\",\"password\":\"{{password}}\",\"name\":\"E2E Shop\",\"role\":\"SELLER\"}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Unapproved seller cannot manage products",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('403', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{sellerToken}}"
              }
            ],
            "url": "{{baseUrl}}/seller/products"
          }
        },
        {
          "name": "Admin approves the seller",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/admin/sellers/{{sellerId}}/approve"
          }
        },
        {
          "name": "Admin creates a category",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201', () => {",
                  "  pm.response.to.have.status(201);",
                  "  pm.collectionVariables.set('categoryId', pm.response.json().data.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"E2E Category {{$timestamp}}\"}"
            },
            "url": "{{baseUrl}}/admin/categories"
          }
        },
        {
          "name": "Active product without an image is 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('400 VALIDATION_ERROR (not 500)', () => {",
                  "  pm.response.to.have.status(400);",
                  "  pm.expect(pm.response.json().error.code).to.eql('VALIDATION_ERROR');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{sellerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"E2E No Image\",\"price\":100000,\"stock\":1,\"categoryId\":\"{{categoryId}}\"}"
            },
            "url": "{{baseUrl}}/seller/products"
          }
        },
        {
          "name": "Seller creates a product (stock 5)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201', () => {",
                  "  pm.response.to.have.status(201);",
                  "  pm.collectionVariables.set('productId', pm.response.json().data.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{sellerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"E2E Phone\",\"description\":\"E2E\",\"imageUrl\":\"https://example.com/e2e-phone.jpg\",\"price\":100000,\"stock\":5,\"categoryId\":\"{{categoryId}}\"}"
            },
            "url": "{{baseUrl}}/seller/products"
          }
        },
        {
          "name": "Seller sees only active carriers",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('active carrier listed, inactive one hidden', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const ids = pm.response.json().data.map(c => c.id);",
                  "  pm.expect(ids).to.include(pm.collectionVariables.get('carrierId'));",
                  "  pm.expect(ids).to.not.include(pm.collectionVariables.get('inactiveCarrierId'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{sellerToken}}"
              }
            ],
            "url": "{{baseUrl}}/seller/carriers"
          }
        }
      ]
    },
    {
      "name": "4. COD purchase to COMPLETED",
      "item": [
        {
          "name": "Customer adds 2 to the cart",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 and the line', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "  pm.collectionVariables.set('cartItemId', pm.response.json().data.items[0].id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"productId\":\"{{productId}}\",\"quantity\":2}"
            },
            "url": "{{baseUrl}}/cart/items"
          }
        },
        {
          "name": "Checkout COD",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201, PENDING, total 200000.00', () => {",
                  "  pm.response.to.have.status(201);",
                  "  const data = pm.response.json().data;",
                  "  pm.expect(data.status).to.eql('PENDING');",
                  "  pm.expect(data.totalAmount).to.eql('200000.00');",
                  "  pm.expect(data.paymentUrl).to.eql(null);",
                  "  pm.collectionVariables.set('orderId', data.id);",
                  "  pm.collectionVariables.set('orderItemId', data.items[0].id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"cartItemIds\":[\"{{cartItemId}}\"],\"shippingAddress\":\"1 E2E Street\",\"paymentMethod\":\"COD\"}"
            },
            "url": "{{baseUrl}}/orders"
          }
        },
        {
          "name": "Stock went down to 3",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('stock 3', () => pm.expect(pm.response.json().data.stock).to.eql(3));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/products/{{productId}}"
          }
        },
        {
          "name": "Seller confirms the line",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 CONFIRMED', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().data.status).to.eql('CONFIRMED');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{sellerToken}}"
              }
            ],
            "url": "{{baseUrl}}/seller/order-items/{{orderItemId}}/confirm"
          }
        },
        {
          "name": "Shipment with an inactive carrier is 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
