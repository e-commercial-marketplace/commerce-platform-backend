            },
            "url": "{{baseUrl}}/seller/shipments"
          }
        },
        {
          "name": "Line in a shipment cannot be cancelled directly",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('409 CANNOT_CANCEL_AFTER_SHIPMENT', () => {",
                  "  pm.response.to.have.status(409);",
                  "  pm.expect(pm.response.json().error.code).to.eql('CANNOT_CANCEL_AFTER_SHIPMENT');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{sellerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": "{{baseUrl}}/seller/order-items/{{orderItemId}}/cancel"
          }
        },
        {
          "name": "Shipment PREPARING",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 PREPARING', () => pm.expect(pm.response.json().data.status).to.eql('PREPARING'));"
                ]
              }
            }
          ],
