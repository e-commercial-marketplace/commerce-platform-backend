# Mẫu cấu hình môi trường local cho backend.
# Cách dùng: copy file này thành .env (cùng thư mục backend/) rồi thay giá trị thật.
#   - .env bị .gitignore chặn; KHÔNG commit secret thật vào Git.
#   - Spring đọc .env ở dạng properties: viết KEY=value, KHÔNG dùng dấu ngoặc kép,
#     không thêm tiền tố "export ", không dùng dấu \ (properties hiểu là escape), và
#     không dùng ký tự # trong giá trị.
#   - Giá trị có ký tự đặc biệt (mật khẩu, tham số URL) phải URL-encode khi đặt trong DB_URL.
#   - Docker Compose cũng tự đọc backend/.env để thay các biến ${...} trong docker-compose.yml.

# --- Database ---
# DB_URL dùng chung cho CẢ HAI cách chạy: `mvn spring-boot:run` (Spring đọc .env) và backend
# trong Docker (compose truyền DB_URL vào container). Không còn biến riêng cho container.
# Ví dụ local: API chạy trên host, Postgres trong Docker Compose.
DB_URL=jdbc:postgresql://localhost:5432/marketplace
DB_USERNAME=marketplace
DB_PASSWORD=marketplace
# Tên database; chỉ Docker Compose dùng để tạo DB và dựng JDBC URL mặc định khi DB_URL không được đặt.
DB_NAME=marketplace

# Managed Postgres (Supabase/Neon): trỏ thẳng DB_URL vào endpoint nhà cung cấp, giữ
# sslmode=require. Ví dụ Supabase (Shared Pooler, session mode port 5432):
# DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# DB_USERNAME=postgres.<project-ref>
# DB_PASSWORD=change-me
# Lưu ý: DB_URL chứa localhost KHÔNG dùng được từ trong container — khi DB nằm trên máy host
# mà API chạy trong Docker, dùng jdbc:postgresql://host.docker.internal:5432/<db>.

# --- Bảo mật ---
# Bắt buộc; dùng chuỗi ngẫu nhiên >= 32 ký tự. Sinh bằng: openssl rand -base64 48
APP_JWT_SECRET=dev-only-secret-key-change-me-please-32chars!
# Tùy chọn: thời hạn token (ms). Mặc định 15 phút / 7 ngày.
# APP_JWT_ACCESS_EXPIRATION_MS=900000
# APP_JWT_REFRESH_EXPIRATION_MS=604800000
# Tùy chọn: tạo tài khoản ADMIN đầu tiên khi DB chưa có admin nào. Bỏ trống thì không tạo.
# APP_ADMIN_EMAIL=admin@example.com
# APP_ADMIN_PASSWORD=change-me-strong-password

# Tùy chọn: cho phép trình duyệt gọi API (CORS). Bỏ trống = không origin nào được phép.
# Thử bằng backend/tools/api-tester.html mở từ file: đặt *  (CHỈ dùng khi phát triển).
# APP_CORS_ALLOWED_ORIGIN_PATTERNS=*

# --- Email (mã đặt lại mật khẩu) ---
# false (mặc định): không gửi email, chỉ ghi mã ra log. CHỈ dùng khi phát triển local.
# APP_MAIL_ENABLED=true
# Gmail: MAIL_USERNAME là địa chỉ Gmail, MAIL_PASSWORD là App Password 16 ký tự (viết liền, không khoảng trắng),
# KHÔNG phải mật khẩu đăng nhập Gmail. MAIL_HOST/MAIL_PORT mặc định smtp.gmail.com:587.
# MAIL_USERNAME=your-account@gmail.com
# MAIL_PASSWORD=abcdefghijklmnop
# Tuỳ chọn: địa chỉ người gửi; mặc định bằng MAIL_USERNAME (Gmail yêu cầu trùng tài khoản).
# APP_MAIL_FROM=your-account@gmail.com

# --- VNPAY (thanh toán trước) ---
# Đăng ký merchant sandbox ở https://sandbox.vnpayment.vn/devreg/ rồi lấy hai giá trị trong email VNPAY gửi.
# Để trống thì checkout bằng VNPAY báo lỗi cấu hình; COD vẫn dùng được.
# APP_VNPAY_TMN_CODE=
# APP_VNPAY_HASH_SECRET=
# Khi deploy: đổi thành https://<domain-render>/api/v1/payments/vnpay/return và khai IPN URL
# https://<domain-render>/api/v1/payments/vnpay/ipn trong trang quản trị merchant sandbox.
# APP_VNPAY_RETURN_URL=http://localhost:8080/api/v1/payments/vnpay/return
# Deep link của app nhận kết quả sau khi thanh toán.
# APP_VNPAY_APP_REDIRECT_URL=marketplace://payment-result
# --- Gỡ lỗi ---
# Bật log SQL của Hibernate khi cần soi query (mặc định false).
# JPA_SHOW_SQL=true

# --- Redis (cache đọc: giỏ hàng, danh mục, trang shop; tuỳ chọn) ---
# Local: service redis trong docker-compose. Render: nhập Internal Key Value URL ở Dashboard, không ghi vào file.
# REDIS_URL=redis://redis:6379
# APP_CACHE_ENABLED=true

# --- Trợ lý AI (tuỳ chọn): API tương thích OpenAI ---
# Bỏ trống AI_API_KEY thì /ai/ask vẫn chạy nhưng trả lời bằng luật (answeredBy = RULES).
# Ví dụ DeepSeek: AI_BASE_URL=https://api.deepseek.com, AI_MODEL=deepseek-chat.
# base-url KHÔNG kèm /v1 (client tự thêm /v1/chat/completions).
# AI_BASE_URL=https://api.openai.com
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini

# --- RAG điều khoản (tuỳ chọn): API embedding tương thích OpenAI ---
# Bỏ trống AI_EMBEDDING_API_KEY thì tắt RAG, trợ lý vẫn chạy như trên.
# Model phải trả vector 1536 chiều (cột embedding của bảng policy_chunks).
# AI_EMBEDDING_BASE_URL=https://api.openai.com
# AI_EMBEDDING_API_KEY=
# AI_EMBEDDING_MODEL=text-embedding-3-small
